generator client {
    provider = "prisma-client"
    output   = "client"
}

datasource db {
    provider = "postgresql"
}

enum Scope {
    IT_HARDWARE
    OFFICE_SUPPLIES
    CONSTRUCTION
}

model User {
    id         String  @id @default(cuid())
    authId     String  @unique
    email      String  @unique
    name       String?
    isCustomer Boolean @default(false)

    customerName      String?
    addressCountry    String?
    addressCity       String?
    addressStreet     String?
    addressPostalCode String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()

    suppliers         Supplier[]
    scopes            Scope[]
    contracts         Contract[]
    inventory         Inventory[]
    customers         Customer[]  @relation("SellerToCustomer")
    recordsAsCustomer Customer[]  @relation("LinkedAppUser")
}

model Customer {
    id        String  @id @default(cuid())
    sellerId  String
    appUserId String?

    customerName      String?
    addressCountry    String?
    addressCity       String?
    addressStreet     String?
    addressPostalCode String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()

    seller     User  @relation("SellerToCustomer", fields: [sellerId], references: [id])
    linkedUser User? @relation("LinkedAppUser", fields: [appUserId], references: [id])
}

model Supplier {
    id                String   @id @default(cuid())
    name              String
    phone             String
    email             String
    addressCountry    String
    addressCity       String
    addressStreet     String
    addressPostalCode String
    userId            String
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt()

    user      User       @relation(fields: [userId], references: [id])
    scopes    Scope[]
    contracts Contract[]
}

model Product {
    id        String   @id @default(cuid())
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()

    scope     Scope
    inventory Inventory[]
}

model Contract {
    id         String   @id @default(cuid())
    title      String
    validUntil DateTime
    supplierId String
    userId     String
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt()

    supplier Supplier @relation(fields: [supplierId], references: [id])
    user     User     @relation(fields: [userId], references: [id])

    @@index([supplierId])
    @@index([userId])
}

model Inventory {
    id        String   @id @default(cuid())
    userId    String
    productId String
    quantity  Int      @default(0)
    updatedAt DateTime @updatedAt()

    user    User    @relation(fields: [userId], references: [id])
    product Product @relation(fields: [productId], references: [id])

    @@unique([userId, productId])
    @@index([userId])
}
