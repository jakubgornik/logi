generator client {
    provider = "prisma-client"
    output   = "client"
}

datasource db {
    provider = "postgresql"
}

enum Scope {
    IT_HARDWARE
    OFFICE_SUPPLIES
    CONSTRUCTION
}

enum NotificationType {
    SUPPLIER_CREATED
    SUPPLIER_UPDATED
    SUPPLIER_DELETED
    CONTRACT_CREATED
    CONTRACT_DELETED
    CUSTOMER_CREATED
    CUSTOMER_LINKED
    CUSTOMER_DELETED
    TRANSACTION_CREATED
    TRANSACTION_UPDATED
    TRANSACTION_DELETED
    TRANSACTION_CONFIRMED
    INVENTORY_UPDATED
    INVENTORY_ADDED
    USER_UPDATED
}

model User {
    id     String  @id @default(cuid())
    authId String  @unique
    email  String  @unique
    name   String?

    isCustomer        Boolean @default(false)
    customerName      String?
    addressCountry    String?
    addressCity       String?
    addressStreet     String?
    addressPostalCode String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()

    suppliers         Supplier[]
    scopes            Scope[]
    contracts         Contract[]
    inventory         Inventory[]
    transactions      Transaction[]
    customers         Customer[]     @relation("SellerToCustomer")
    recordsAsCustomer Customer[]     @relation("LinkedAppUser")
    notifications     Notification[]
}

model Customer {
    id        String  @id @default(cuid())
    sellerId  String
    appUserId String?

    customerName      String?
    addressCountry    String?
    addressCity       String?
    addressStreet     String?
    addressPostalCode String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()

    seller        User           @relation("SellerToCustomer", fields: [sellerId], references: [id])
    linkedUser    User?          @relation("LinkedAppUser", fields: [appUserId], references: [id])
    transactions  Transaction[]
    notifications Notification[]
}

model Supplier {
    id                String   @id @default(cuid())
    name              String
    phone             String
    email             String
    addressCountry    String
    addressCity       String
    addressStreet     String
    addressPostalCode String
    userId            String
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt()

    user          User           @relation(fields: [userId], references: [id])
    scopes        Scope[]
    contracts     Contract[]
    notifications Notification[]
}

model Contract {
    id         String   @id @default(cuid())
    title      String
    validUntil DateTime
    supplierId String
    userId     String
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt()

    supplier      Supplier       @relation(fields: [supplierId], references: [id])
    user          User           @relation(fields: [userId], references: [id])
    notifications Notification[]

    @@index([supplierId])
    @@index([userId])
}

model Inventory {
    id        String   @id @default(cuid())
    userId    String
    productId String
    quantity  Int      @default(0)
    updatedAt DateTime @updatedAt()

    user          User           @relation(fields: [userId], references: [id])
    product       Product        @relation(fields: [productId], references: [id])
    notifications Notification[]

    @@unique([userId, productId])
    @@index([userId])
}

model Product {
    id        String   @id @default(cuid())
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()

    scope            Scope
    inventory        Inventory[]
    transactionItems TransactionItem[]
}

enum TransactionStatus {
    DRAFT
    CONFIRMED
}

model Transaction {
    id         String  @id @default(cuid())
    sellerId   String
    customerId String?
    name       String

    status    TransactionStatus @default(DRAFT)
    createdAt DateTime          @default(now())
    updatedAt DateTime          @updatedAt()

    seller        User              @relation(fields: [sellerId], references: [id])
    customer      Customer?         @relation(fields: [customerId], references: [id])
    items         TransactionItem[]
    notifications Notification[]

    @@unique([sellerId, name])
    @@index([sellerId])
    @@index([customerId])
}

model TransactionItem {
    id            String @id @default(cuid())
    transactionId String
    productId     String
    quantity      Int

    transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
    product     Product     @relation(fields: [productId], references: [id])

    @@index([transactionId])
}

model Notification {
    id            String           @id @default(cuid())
    userId        String
    type          NotificationType
    message       String?
    createdAt     DateTime         @default(now())
    supplierId    String?
    contractId    String?
    inventoryId   String?
    transactionId String?
    customerId    String?

    user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    supplier    Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
    contract    Contract?    @relation(fields: [contractId], references: [id], onDelete: SetNull)
    inventory   Inventory?   @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
    transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
    customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

    @@index([userId])
}
